{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StickerProject",
  "type": "object",
  "required": [
    "project_id",
    "name",
    "platform",
    "version",
    "status",
    "sticker_count",
    "output_defaults",
    "master_character"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "idea",
        "planning",
        "production",
        "qc",
        "ready",
        "released"
      ]
    },
    "sticker_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    },
    "character_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_defaults": {
      "type": "object",
      "required": [
        "width",
        "height",
        "format",
        "background"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "type": "string"
        },
        "background": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "master_character": {
      "type": "object",
      "required": [
        "reference",
        "approved"
      ],
      "properties": {
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved": {
          "type": "boolean"
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}